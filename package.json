{
  "name": "pulsecare",
  "version": "1.0.0",
  "description": "PulseCare - Real-Time IoT Hospital Monitoring & Early Warning System",
  "private": true,
  "type": "module",
  "workspaces": [
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "seed": "npm run seed --workspace=@pulsecare/database",
    "create-admin": "npm run create-admin --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
