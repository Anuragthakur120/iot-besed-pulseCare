# ==============================================================================
# PULSECARE BACKEND – ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it is gitignored.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development                          # development | production | test
PORT=5000                                     # HTTP server port
CLIENT_ORIGIN=http://localhost:5173            # Frontend origin(s) for CORS (comma-sep)

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017/pulsecare
# MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/pulsecare
MONGODB_URI=mongodb://localhost:27017/pulsecare

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_char_random_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_min_32_char_random_refresh_secret
ACCESS_TOKEN_TTL=15m                          # Access token lifetime
REFRESH_TOKEN_TTL=7d                          # Refresh token lifetime
COOKIE_SECURE=false                           # Set true in production (HTTPS)

# ── Cloudinary (Profile Photo Storage) ────────────────────────────────────────
# Sign up at https://cloudinary.com/console — free tier: 25 GB storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── SMTP Email Alerts ─────────────────────────────────────────────────────────
# Dev: use https://mailtrap.io (free inbox) — Prod: use SendGrid / SES / Gmail App Password
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=PulseCare Hospital Alerts <alerts@pulsecare.local>

# ── Alert Notification Channels ───────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false                     # Enable email dispatch for alerts
ALERT_SMS_ENABLED=false                       # Enable SMS dispatch for critical alerts

# ── Twilio SMS (optional, for critical alerts) ────────────────────────────────
# Sign up at https://www.twilio.com — free trial includes test SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── IoT Hardware Security ────────────────────────────────────────────────────
# HMAC pepper used to validate ESP32 device telemetry signatures
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_HMAC_PEPPER=CHANGE_ME_device_hmac_secret_pepper

# Seconds after which a device reading is considered stale
STALE_THRESHOLD_SECONDS=15

# ── Ops & Governance ─────────────────────────────────────────────────────────
RAW_READING_RETENTION_DAYS=30                 # Auto-delete raw telemetry after N days
SENTRY_DSN=                                   # Sentry error tracking DSN (optional)
ENABLE_SWAGGER=true                           # Serve /api/docs Swagger UI
INVITATION_TTL_HOURS=48                       # Staff invitation link expiry
DELETION_COOLING_DAYS=7                       # GDPR data deletion cooling period

# ── Seed Data (Dev Only — NEVER use in production) ───────────────────────────
SEED_ADMIN_EMAIL=admin@pulsecare.dev
SEED_ADMIN_PASSWORD=CHANGE_ME_AdminPassword123!
SEED_DOCTOR_EMAIL=doctor@pulsecare.dev
SEED_DOCTOR_PASSWORD=CHANGE_ME_DoctorPassword123!
SEED_PATIENT_EMAIL=patient@pulsecare.dev
SEED_PATIENT_PASSWORD=CHANGE_ME_PatientPassword123!
SEED_FORCE_RESET=false
