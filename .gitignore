# ==============================================================================
# PulseCare – Git Ignore Rules
# ==============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Environment & Secrets (CRITICAL: never commit real credentials) ───────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# ── Firebase / GCP Service Account Keys ───────────────────────────────────────
serviceAccountKey.json
*-firebase-adminsdk-*.json

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime data & temp files ─────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
.temp/
temp/
tmp/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.tsbuildinfo

# ── Testing & Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/

# ── OS and Editor artifacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Database storage dumps ────────────────────────────────────────────────────
data/
mongo_data/
dump/

# ── ESP32 Firmware Secrets ────────────────────────────────────────────────────
firmware/pulsecare_esp32/config.h
*.bin
*.elf

# ── Python (if any scripts) ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/

# ── Docker persistent volumes ────────────────────────────────────────────────
docker-data/

# ── Uploaded files (generated at runtime) ─────────────────────────────────────
backend/uploads/
!backend/uploads/.gitkeep
