# ==============================================================================
# PULSECARE MONOREPO – ROOT ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your real values.
# This file is safe to commit – it contains NO secrets.
# ==============================================================================

# Node.js environment (development | production | test)
NODE_ENV=development

# Backend HTTP server port
PORT=5000

# Frontend origin URL (comma-separated for multiple origins)
# Used by backend CORS and Socket.IO origin validation
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string
# Local: mongodb://localhost:27017/pulsecare
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/pulsecare
MONGODB_URI=mongodb://localhost:27017/pulsecare

# Frontend Vite build-time variables (must start with VITE_)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
